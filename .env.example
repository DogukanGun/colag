DATABASE_URL=postgres://colag:colag@127.0.0.1:54329/colag
REDIS_URL=redis://127.0.0.1:63799
COLAG_PORT=4310
COLAG_WEB_ORIGIN=http://localhost:3000
COLAG_COLLAB_PORT=4311
CLAUDE_BIN=claude
COLAG_TASK_TIMEOUT_MS=900000
COLAG_MAX_PARALLEL=2
COLAG_A2A_ENDPOINT=http://127.0.0.1:4320
# Demo videos: the voice-over (xAI text to speech), the recorder image (pnpm demo:image) and limits
XAI_API_KEY=
COLAG_DEMO_RECORDER_IMAGE=colag-demo-recorder
COLAG_DEMO_DAILY_LIMIT=10
COLAG_DEMO_TIMEOUT_MS=600000

# Model provider for hosted Colag agents.
# claude  : spawn the authenticated Claude Code CLI on this host.
# openai  : any OpenAI-compatible chat endpoint. This example is AMD Token Factory
#           (team-1204). Nebius Token Factory, a vLLM server, or a local server
#           use the same three settings with their own URL, key, and model name.
COLAG_MODEL_PROVIDER=openai
COLAG_MODEL_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# Team key from notebooks.amd.com/tokenfactory. Leave this empty in git.
COLAG_MODEL_API_KEY=
COLAG_MODEL_NAME=DeepSeek-V4.1-Flash
# COLAG_MODEL_MAX_TURNS=60
# COLAG_MODEL_REQUEST_TIMEOUT_MS=180000
# COLAG_MODEL_MAX_RETRIES=5   # waits out 429 and 502-504 answers (shared team keys hit rate limits)
