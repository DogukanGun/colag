DATABASE_URL=postgres://colag:colag@127.0.0.1:54329/colag
REDIS_URL=redis://127.0.0.1:63799
COLAG_PORT=4310
COLAG_WEB_ORIGIN=http://localhost:3000
COLAG_COLLAB_PORT=4311
CLAUDE_BIN=claude
COLAG_TASK_TIMEOUT_MS=900000
COLAG_MAX_PARALLEL=2
COLAG_A2A_ENDPOINT=http://127.0.0.1:4320

# Model provider for hosted Colag agents.
# claude  : spawn the authenticated Claude Code CLI on this host (default).
# openai  : any OpenAI-compatible chat endpoint, e.g. Nebius Token Factory,
#           a vLLM server on AMD Developer Cloud, or a local server.
COLAG_MODEL_PROVIDER=claude
# COLAG_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1
# COLAG_MODEL_API_KEY=
# COLAG_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
# COLAG_MODEL_MAX_TURNS=60
# COLAG_MODEL_REQUEST_TIMEOUT_MS=180000
